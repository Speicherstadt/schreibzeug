{
  "$schema": "https://schema.tauri.app/config/3.0.0-alpha.5",
  "productName": "Schreibzeug",
  "version": "../package.json",
  "identifier": "io.github.firsttris.schreibzeug",
  "build": {
    "beforeDevCommand": "bun run sidecar && bun run start:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run start:build && bun run sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Office files, edited together",
    "longDescription": "Documents, spreadsheets and presentations: the files on this computer, or on a Schreibzeug server, edited together in real time.",
    "copyright": "AGPL-3.0-only",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["docx", "docm", "doc", "dotx", "dotm", "dot", "rtf", "odt"],
        "name": "Word document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["xlsx", "xlsm", "xls", "xltx", "xltm", "xlt", "csv", "ods"],
        "name": "Excel spreadsheet",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["pptx", "pptm", "ppt", "ppsx", "ppsm", "pps", "potx", "potm", "pot", "odp"],
        "name": "PowerPoint presentation",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["pdf"],
        "name": "PDF document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["md", "markdown"],
        "name": "Markdown text",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["txt"],
        "name": "Plain text",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "externalBin": ["binaries/schreibzeug-local"],
    "resources": {
      "../../web/dist/": "web/"
    },
    "linux": {
      "rpm": {
        "compression": {
          "type": "zstd",
          "level": 3
        }
      }
    },
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    }
  }
}
