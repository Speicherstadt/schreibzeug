{
  "$schema": "https://schema.tauri.app/config/3.0.0-alpha.5",
  "productName": "Schreibzeug",
  "version": "../package.json",
  "identifier": "io.github.firsttris.schreibzeug",
  "build": {
    "beforeDevCommand": "bun run sidecar && bun run start:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run start:build && bun run sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Office files, edited together",
    "longDescription": "Documents, spreadsheets and presentations: the files on this computer, or on a Schreibzeug server, edited together in real time.",
    "copyright": "AGPL-3.0-only",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["docx"],
        "name": "Schreibzeug.docx",
        "description": "Word document",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["doc"],
        "name": "Schreibzeug.doc",
        "description": "Word 97-2003 document",
        "mimeType": "application/msword",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["rtf"],
        "name": "Schreibzeug.rtf",
        "description": "Rich Text document",
        "mimeType": "application/rtf",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["odt"],
        "name": "Schreibzeug.odt",
        "description": "OpenDocument text",
        "mimeType": "application/vnd.oasis.opendocument.text",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["xlsx"],
        "name": "Schreibzeug.xlsx",
        "description": "Excel workbook",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["xls"],
        "name": "Schreibzeug.xls",
        "description": "Excel 97-2003 workbook",
        "mimeType": "application/vnd.ms-excel",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["csv"],
        "name": "Schreibzeug.csv",
        "description": "CSV file",
        "mimeType": "text/csv",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["ods"],
        "name": "Schreibzeug.ods",
        "description": "OpenDocument spreadsheet",
        "mimeType": "application/vnd.oasis.opendocument.spreadsheet",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["pptx"],
        "name": "Schreibzeug.pptx",
        "description": "PowerPoint presentation",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["ppt"],
        "name": "Schreibzeug.ppt",
        "description": "PowerPoint 97-2003 presentation",
        "mimeType": "application/vnd.ms-powerpoint",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["odp"],
        "name": "Schreibzeug.odp",
        "description": "OpenDocument presentation",
        "mimeType": "application/vnd.oasis.opendocument.presentation",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["pdf"],
        "name": "Schreibzeug.pdf",
        "description": "PDF document",
        "mimeType": "application/pdf",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["md"],
        "name": "Schreibzeug.md",
        "description": "Markdown text",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["txt"],
        "name": "Schreibzeug.txt",
        "description": "Plain text",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "externalBin": ["binaries/schreibzeug-local"],
    "resources": {
      "../../web/dist/": "web/"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/schreibzeug.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/schreibzeug.desktop",
        "compression": { "type": "zstd", "level": 3 }
      }
    },
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    }
  }
}
